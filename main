//https://insidetattoo.ro/wp-admin/admin-post.php?action=export_inactive_customers
add_action('admin_post_export_inactive_customers', 'export_inactive_customers_csv');

function export_inactive_customers_csv() {

    if (!is_user_logged_in() || !current_user_can('manage_woocommerce')) {
        wp_die('Unauthorized');
    }

    global $wpdb;

    $date_limit = date('Y-m-d H:i:s', strtotime('-3 months'));

    // Get last order date per user (including users with no orders)
    $results = $wpdb->get_results("
        SELECT 
            u.ID as user_id,
            u.user_email,
            MAX(p.post_date) as last_order_date
        FROM {$wpdb->users} u
        LEFT JOIN {$wpdb->postmeta} pm 
            ON pm.meta_value = u.ID AND pm.meta_key = '_customer_user'
        LEFT JOIN {$wpdb->posts} p 
            ON p.ID = pm.post_id
            AND p.post_type = 'shop_order'
            AND p.post_status IN ('wc-completed', 'wc-processing')
        GROUP BY u.ID
    ");

    header('Content-Type: text/csv');
    header('Content-Disposition: attachment;filename=inactive_customers_last_3_months.csv');

    $output = fopen('php://output', 'w');

    fputcsv($output, ['User ID', 'Email', 'First Name', 'Last Name', 'Billing Phone', 'Last Order Date']);

    foreach ($results as $row) {

        // Condition: no orders OR last order older than 3 months
        if (empty($row->last_order_date) || $row->last_order_date < $date_limit) {

            $user = get_user_by('id', $row->user_id);
            if (!$user) continue;

            fputcsv($output, [
				$user->ID,
				$user->user_email,
				get_user_meta($user->ID, 'first_name', true),
				get_user_meta($user->ID, 'last_name', true),
				get_user_meta($user->ID, 'billing_phone', true),
				$row->last_order_date ? $row->last_order_date : 'Never'
			]);
        }
    }

    fclose($output);
    exit;
}
