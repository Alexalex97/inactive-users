//https://insidetattoo.ro/wp-admin/admin-post.php?action=export_inactive_customers
add_action('admin_post_export_inactive_customers', 'export_inactive_customers_csv');

function export_inactive_customers_csv() {
    if (!is_user_logged_in() || !current_user_can('manage_woocommerce')) {
        wp_die('Unauthorized');
    }

    // Prevent timeouts on large order databases
    if (function_exists('set_time_limit')) {
        @set_time_limit(300);
    }

    global $wpdb;

    $date_limit = date('Y-m-d H:i:s', strtotime('-3 months'));

    // Pull registered customers with past orders, excluding anyone who ordered in the last 3 months
    $query = $wpdb->prepare("
        SELECT 
            u.ID AS user_id,
            u.user_email AS email,
            MAX(p.post_date) AS last_order_date
        FROM {$wpdb->users} u
        INNER JOIN {$wpdb->postmeta} pm_email 
            ON pm_email.meta_key = '_billing_email' 
            AND pm_email.meta_value = u.user_email
        INNER JOIN {$wpdb->posts} p 
            ON p.ID = pm_email.post_id 
            AND p.post_type = 'shop_order' 
            AND p.post_status IN ('wc-completed', 'wc-processing')
        WHERE u.user_email NOT IN (
            SELECT DISTINCT pm_recent.meta_value
            FROM {$wpdb->posts} p_recent
            INNER JOIN {$wpdb->postmeta} pm_recent 
                ON p_recent.ID = pm_recent.post_id
            WHERE p_recent.post_type = 'shop_order'
              AND p_recent.post_status IN ('wc-completed', 'wc-processing')
              AND pm_recent.meta_key = '_billing_email'
              AND p_recent.post_date >= %s
        )
        GROUP BY u.ID, u.user_email
    ", $date_limit);

    $results = $wpdb->get_results($query);

    header('Content-Type: text/csv; charset=utf-8');
    header('Content-Disposition: attachment; filename=inactive_customers_last_3_months.csv');
    header('Pragma: no-cache');
    header('Expires: 0');

    $output = fopen('php://output', 'w');

    // Add UTF-8 BOM so Excel opens special characters (diacritics) correctly
    fputs($output, "\xEF\xBB\xBF");

    fputcsv($output, ['User ID', 'Email', 'First Name', 'Last Name', 'Last Order Date']);

    foreach ($results as $row) {
        $first_name = get_user_meta($row->user_id, 'billing_first_name', true) ?: get_user_meta($row->user_id, 'first_name', true);
        $last_name  = get_user_meta($row->user_id, 'billing_last_name', true) ?: get_user_meta($row->user_id, 'last_name', true);

        fputcsv($output, [
            $row->user_id,
            $row->email,
            $first_name,
            $last_name,
            $row->last_order_date
        ]);
    }

    fclose($output);
    exit;
}
